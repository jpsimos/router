# Daemon
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=2
ctrl_interface=/run/router
ctrl_interface_group=router

# Driver and Phy
driver=nl80211
country_code=US
country3=0x49
hw_mode=g
ieee80211n=1
ieee80211w=1
uapsd_advertisement_enabled=1
wmm_enabled=1
ht_capab=[LDPC][SHORT-GI-20][HT40-][SHORT-GI-40][TX-STBC][RX-STBC1][MAX-AMSDU-7935]

# AP
ssid=DenOfBungieCoords
utf8_ssid=1
channel=11
beacon_int=100
max_num_sta=20
no_probe_resp_if_max_sta=20
rssi_ignore_probe_request=-75
ap_max_inactivity=300
disassoc_low_ack=1
obss_interval=60
rrm_beacon_report=1

# Authentication
auth_algs=1
wpa=2
wpa_passphrase=OffDemMarlb0roughS-
sae_password=OffDemMarlb0roughS-
sae_pwe=2
wpa_key_mgmt=WPA-PSK SAE
wpa_pairwise=CCMP
rsn_pairwise=CCMP
