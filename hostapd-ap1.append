# Author Jacob A. Psimos

# Daemon
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=2
ctrl_interface=/run/router
ctrl_interface_group=router

# Driver and Phy
driver=nl80211
country_code=US
country3=0x49
ieee80211d=1
ieee80211n=1
ieee80211ac=1
wmm_enabled=1

# AP
ssid=salt
beacon_int=100
channel=36
hw_mode=a
ht_capab=[HT40+]
vht_oper_chwidth=1
vht_oper_centr_freq_seg0_idx=42
no_probe_resp_if_max_sta=20
rssi_ignore_probe_request=-78
ap_max_inactivity=300
disassoc_low_ack=1
obss_interval=60

# Authentication
auth_algs=1
wpa=2
wpa_passphrase=pepper
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
wpa_disable_eapol_key_retries=1
